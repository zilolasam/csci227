<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;450;500;600&display=swap" rel="stylesheet">
<STYLE>
:root {
  --bg: #0d1117;
  --bg-raised: #151b23;
  --border: #262f3d;
  --border-soft: #1e2632;
  --text: #e6ebf1;
  --text-dim: #9aa7b8;
  --text-faint: #6b7788;
  --py-blue: #6ba8dc;
  --py-gold: #f4c542;
}
body {
  background: var(--bg);
  color: var(--text);
  font-family: "Inter", system-ui, -apple-system, sans-serif;
  font-size: 15.5px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}
A { text-decoration: none; color: var(--py-blue); transition: color .15s ease; }
A:hover { color: #9cc7ec; }
A:focus-visible { outline: 2px solid var(--py-gold); outline-offset: 2px; border-radius: 3px; }
th, td { padding: 5px; }
h2, h3 {
  font-family: "Space Grotesk", sans-serif;
  font-weight: 600;
  letter-spacing: -.01em;
}
b, strong { color: var(--text); }
p, li { color: var(--text-dim); }
hr { border: none; border-top: 1px solid var(--border-soft); }
li::marker { color: var(--py-gold); }
code {
  font-family: "JetBrains Mono", monospace;
  font-size: .9em;
  background-color: var(--bg-raised);
  color: var(--text);
}
.inline {
  padding: 1px 5px;
  border-radius: 4px;
}
.blockcode {
  border: 1px solid var(--border);
  border-radius: 6px;
  display: block;
  padding-left: 10px;
  padding-top : 2px;
  padding-bottom : 2px;
  margin: 5px;
}
.datablock {
  border: 1px solid var(--border-soft);
  border-radius: 6px;
  background: var(--bg-raised);
  color: var(--text-dim);
  display: block;
  padding: 7px;
  padding-top : 0px;
  margin: 5px;
}
blockquote {
  background: var(--bg-raised);
  border-left: 3px solid var(--py-gold);
  border-radius: 6px;
  padding: 14px 18px;
  color: var(--text-dim);
}
img { background: #ffffff; border-radius: 6px; }
</STYLE>
<body>


